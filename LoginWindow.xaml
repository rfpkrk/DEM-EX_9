<Window x:Class="MilkBase_9.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilkBase_9"
        mc:Ignorable="d"
       Title="Вход в систему"
        Height="520" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Вход в систему" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        <TextBlock Grid.Row="1" Text="Хлебобулочный завод" FontSize="14" Foreground="#666" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Grid.Row="2" Text="Логин" Margin="0,0,0,5"/>
        <TextBox x:Name="txtUsername" Grid.Row="3" Height="35" Margin="0,0,0,15" />
        <TextBlock Grid.Row="4" Text="Пароль" Margin="0,0,0,5"/>
        <PasswordBox x:Name="txtPassword" Grid.Row="5" Height="35" Margin="0,0,0,15" />
        <TextBlock Grid.Row="6" Text="Код подтверждения" Margin="0,0,0,5"/>
        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtCaptchaInput" Grid.Column="0" Height="35" />
            <Button x:Name="btnRefreshCaptcha" Grid.Column="1" Content="Обновить" 
                    Width="70" Height="35" Margin="8,0,0,0"
                    Click="BtnRefreshCaptcha_Click"/>
        </Grid>
        <Border Grid.Row="8" Background="#E0E0E0" Margin="0,0,0,15" Height="50">
            <TextBlock x:Name="txtCaptcha" FontSize="20" FontWeight="Bold" 
                       FontFamily="Courier New" HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnLogin" Content="Войти" Width="100" Height="35" 
                    Margin="0,0,10,0" Click="BtnLogin_Click"/>
            <Button Content="Отмена" Width="100" Height="35" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

