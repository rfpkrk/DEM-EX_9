<Window x:Class="MilkBase_9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MilkBase_9"
        mc:Ignorable="d"
        Title="Главная страницы"
        Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        MinHeight="400" MinWidth="700">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <TextBlock Text="Система управления" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </Border>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="btnUserManagement" 
                    Click="BtnUserManagement_Click" 
                    Width="250" Height="50" 
                    Margin="0,10"
                    Background="#3498DB" 
                    Foreground="White" 
                    FontSize="16" 
                    FontWeight="Bold"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Управление пользователями"/>
                </StackPanel>
            </Button>

            <TextBlock x:Name="txtWelcome" FontSize="14" Foreground="#666" HorizontalAlignment="Center" Margin="0,20,0,0"/>
        </StackPanel>
        <StatusBar Grid.Row="2" Background="#2C3E50" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="txtUserInfo" Text="Пользователь: "/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="txtDate"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
